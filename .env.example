# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI — usada para geração de peças e revisor jurídico (modelo gpt-4.1-mini)
OPENAI_API_KEY=sk-...

# Kiwify (gateway de assinaturas)
# Token usado para validar o postback (Webhook Signature na Kiwify).
KIWIFY_WEBHOOK_TOKEN=seu_token_de_webhook_kiwify
# Link público de checkout para cada plano (criado em "Vendas/Produtos" no painel).
NEXT_PUBLIC_KIWIFY_CHECKOUT_BASIC=https://pay.kiwify.com.br/AAAAAA
NEXT_PUBLIC_KIWIFY_CHECKOUT_PREMIUM=https://pay.kiwify.com.br/BBBBBB
NEXT_PUBLIC_KIWIFY_CHECKOUT_PROFESSIONAL=https://pay.kiwify.com.br/CCCCCC
# Estratégia A — 3 produtos separados (1 por plano):
# Preencha os product_id que aparecem no postback como `Product.product_id`.
KIWIFY_PRODUCT_ID_BASIC=
KIWIFY_PRODUCT_ID_PREMIUM=
KIWIFY_PRODUCT_ID_PROFESSIONAL=

# Estratégia B (RECOMENDADA pra SaaS) — 1 produto com 3 ofertas/planos:
# Preencha os plan_id que aparecem no postback como `Subscription.plan.id`.
# Se ambos estiverem setados, o webhook prioriza o plan_id.
KIWIFY_PLAN_ID_BASIC=
KIWIFY_PLAN_ID_PREMIUM=
KIWIFY_PLAN_ID_PROFESSIONAL=
# Área do cliente na Kiwify (onde ele gerencia a assinatura).
NEXT_PUBLIC_KIWIFY_CUSTOMER_AREA=https://kiwify.app/account

# Resend (transactional emails) — usado para enviar a senha provisória após o checkout.
# Se ausente, o webhook ainda funciona, mas a senha precisa ser resgatada do log.
RESEND_API_KEY=re_...
EMAIL_FROM=Peça Pronta <contato@pecapronta.app>

# Meta Pixel + Conversions API (CAPI)
# Pixel ID aparece em Meta Business → Eventos → Configurações
NEXT_PUBLIC_META_PIXEL_ID=
# Access Token criado em Meta Business → Eventos → Configurações → Gerar token
# (necessário só pro server-side CAPI)
META_CAPI_ACCESS_TOKEN=
# Test Event Code (opcional, só pra debug em Meta Business → Test Events)
META_CAPI_TEST_EVENT_CODE=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
