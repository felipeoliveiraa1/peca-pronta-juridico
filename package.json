{
  "name": "peca-pronta-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:extras": "prisma db execute --file prisma/extras.sql --schema prisma/schema.prisma",
